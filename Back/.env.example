# Copy this file to .env and set real secrets
# Optional: enable local test route (DO NOT enable in production)
# ENABLE_AI_TEST_ROUTE=1
# Backend runtime
PORT=5000
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/fortcode
JWT_SECRET=replace_with_strong_secret
SESSION_SECRET=replace_with_strong_session_secret

# Email (optional, for invitation emails)
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Sonar (optional, for quality sync)
SONARQUBE_URL=https://sonarcloud.io
SONARQUBE_TOKEN=replace_with_sonar_token
SONARQUBE_ORGANIZATION=replace_with_org_key
SONAR_SCANNER_BIN=sonar-scanner

# AI scoring provider (default: ollama)
AI_SCORE_PROVIDER=ollama

# Ollama (local/free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI — required for real AI-generated exercises (stages + challenge drafts)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Retries when OpenAI returns 429 / 5xx (default 8, max 12)
# OPENAI_MAX_RETRIES=8
# Min delay between OpenAI requests (ms) — lowers burst 429 (default 4500)
# OPENAI_MIN_GAP_MS=4500
# Pause before 2nd call when JSON/tests validation fails (default 10000)
# OPENAI_VALIDATION_RETRY_GAP_MS=10000
# Optional: dev-only placeholder exercises if OPENAI_API_KEY is unset (never use in production)
# ENABLE_AI_STUB=1
